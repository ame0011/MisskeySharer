<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12(API 31)以降のバックアップ／端末移行の制御。
    MiAuth トークンを含む SharedPreferences を一切バックアップ・転送しないよう、
    すべてのドメインを除外する（allowBackup="false" と同等の挙動）。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="./" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="./" />
    </device-transfer>
</data-extraction-rules>
