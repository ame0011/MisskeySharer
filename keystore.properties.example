# リリース署名用の設定テンプレート。
# このファイルをコピーして `keystore.properties` を作成し、値を埋めてください。
# `keystore.properties` は .gitignore 済みでリポジトリにはコミットされません。
#
# 設定後 `./gradlew assembleRelease` を実行で
# 署名済みの app-release.apk が出力されます。
# (keystore.properties が無い場合は未署名APKになります)

# キーストアのパス
# リポジトリ直下からの相対パス、または絶対パスで指定
storeFile=release.jks

# キーストアのパスワード
storePassword=your-keystore-password

# キーのエイリアス
# `keytool -list -v -keystore <file>` で確認できます
keyAlias=your-key-alias

# キーのパスワード(キーストアと同じにしている場合が多いです)
keyPassword=your-key-password
